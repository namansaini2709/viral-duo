# =========================================================================
# The Viral Duo - Secure Environment Variable Configuration Template
# =========================================================================
# Copy this file to '.env.local' and set the actual values.
# IMPORTANT: NEVER commit '.env.local' or any active credentials to Git!

# -------------------------------------------------------------------------
# Client-Facing (Safe for browser / Exposed via NextJS compiler)
# -------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://theviralduo.com

# -------------------------------------------------------------------------
# Server-Only Credentials (NEVER expose to the client-side / No public prefix)
# -------------------------------------------------------------------------
# Supported Providers: "resend" | "mailchimp" | "convertkit" | "mock"
NEWSLETTER_PROVIDER=mock

# Server-only third-party newsletter service credential key
NEWSLETTER_API_KEY=your_secure_server_only_api_key_here

# Specific target mailing audience/list identifier
NEWSLETTER_LIST_ID=your_target_audience_or_list_id_here
